# Copy to .env and edit. NEVER commit .env. This file must contain placeholders only.

ENVIRONMENT=local            # local | test | production  (local => human-readable logs)
LOG_LEVEL=INFO

# --- Docker Compose services (used to create the database and to build the api's URL) ---
POSTGRES_USER=rescueai
POSTGRES_PASSWORD=change-me      # use URL-safe characters (letters/digits); it is embedded in a URL
POSTGRES_DB=rescueai

# --- Only used when running the API on your host (uv run uvicorn ...) against compose services.
# Keep the password identical to POSTGRES_PASSWORD above. Inside Compose these are overridden.
DATABASE_URL=postgresql+psycopg://rescueai:change-me@localhost:5432/rescueai
REDIS_URL=redis://localhost:6379/0

# --- Optional tuning (defaults shown) ---
# STARTUP_CHECK_ENABLED=true          # wait for PostgreSQL + Redis at boot, then fail fast
# STARTUP_MAX_WAIT_SECONDS=30
# CELERY_BROKER_URL=                  # blank => uses REDIS_URL
# HEALTH_CHECK_TIMEOUT_SECONDS=2
# DEFAULT_MAX_ATTEMPTS=5              # retry budget for new jobs (1-10)
